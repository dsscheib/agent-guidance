#!/bin/sh
set -e
ROOT=$(git rev-parse --show-toplevel)
if [ -f "$ROOT/scripts/verify.py" ] && { [ -f "$ROOT/.guidance.json" ] || [ ! -f "$ROOT/MAINTAINING.md" ] || [ ! -f "$ROOT/manage.py" ] || [ ! -f "$ROOT/PACKAGE_MANIFEST.json" ] || ! grep -q '"repo_only"' "$ROOT/PACKAGE_MANIFEST.json"; }; then
  exec python3 "$ROOT/scripts/verify.py"
elif [ -f "$ROOT/manage.py" ]; then
  exec python3 "$ROOT/manage.py"
fi
echo "No guidance checker found (expected scripts/verify.py or manage.py in $ROOT)" >&2
exit 1
