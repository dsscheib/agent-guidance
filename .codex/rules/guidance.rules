# Mirrors AGENTS.md rules 2 and 3: destructive git operations, merges, approvals and releases need
# confirmation. `git push` is left to rule 3: a prompt cannot tell a push the owner asked for from one
# they did not, so it only got in the way of authorized pushes.
# Codex loads project rules only when this project's .codex/ layer is trusted.
# Loosen only to match the agent git policy adopted in PROJECT_PROFILE.md.

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "AGENTS.md rule 2: may discard uncommitted work.",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "AGENTS.md rule 2: may delete untracked work.",
)

prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "prompt",
    justification = "AGENTS.md rule 2: may delete unmerged work.",
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "prompt",
    justification = "AGENTS.md rule 2: rewrites history.",
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "prompt",
    justification = "AGENTS.md rule 2: may discard uncommitted work.",
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "prompt",
    justification = "AGENTS.md rule 3: merge only with explicit authorization; never your own work.",
)

prefix_rule(
    pattern = ["gh", "pr", "review"],
    decision = "prompt",
    justification = "AGENTS.md rule 3: reviews and approvals belong to the approver, never your own work.",
)

prefix_rule(
    pattern = ["gh", "release", "create"],
    decision = "prompt",
    justification = "AGENTS.md rule 3: publish only with explicit authorization.",
)
