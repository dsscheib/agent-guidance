{
  "package": "reusable-project-guidance",
  "version": "3.0",
  "status": "unconfigured-templates",
  "procedures": "docs/procedures",
  "adapters": [
    {
      "dir": ".agents/skills",
      "tools": "Codex, Antigravity and Copilot CLI"
    },
    {
      "dir": ".claude/skills",
      "tools": "Claude Code and Copilot CLI"
    }
  ],
  "repo_only": [
    "MAINTAINING.md",
    "LICENSE",
    "maintainer/",
    ".claude/settings.local.json"
  ],
  "shim_exempt": [
    "maintainer/fixtures/"
  ],
  "modules": {
    "core": "Every project: agent instructions, profile, work register, change and testing policy, checker, guardrails, bootstrap, final audit and upgrade",
    "design": "Requirements, architecture, domain rules, decisions and roadmap",
    "operations": "Runbooks, release notes and the security and production policy",
    "release": "Verification matrix, release readiness and review templates",
    "production-ops": "Selected-host qualification and soak protocol",
    "enterprise": "Traceability, roles and separation of duties, CI evidence and supply-chain gates",
    "ui": "Feature: UX, UI patterns, acceptance checklist and branding",
    "data": "Feature: import, export and file formats",
    "stack-go": "Feature: server-rendered web profile for Go",
    "stack-rust": "Feature: server-rendered web profile for Rust"
  },
  "tiers": {
    "prototype": [
      "core"
    ],
    "internal": [
      "core",
      "design",
      "operations"
    ],
    "production": [
      "core",
      "design",
      "operations",
      "release",
      "production-ops"
    ],
    "enterprise": [
      "core",
      "design",
      "operations",
      "release",
      "production-ops",
      "enterprise"
    ]
  },
  "features": {
    "ui": [
      "ui"
    ],
    "data": [
      "data"
    ],
    "stack-go": [
      "stack-go"
    ],
    "stack-rust": [
      "stack-rust"
    ]
  },
  "agents_tables": {
    "routing": [
      {
        "module": "core",
        "row": "| Any behavior | [TESTING_SPEC](docs/TESTING_SPEC.md), [CHANGE_WORKFLOW](docs/CHANGE_WORKFLOW.md) | Tests for the changed behavior; run `python3 check_package.py --verify` |"
      },
      {
        "module": "core",
        "row": "| A rename or refactor that keeps behavior | [CHANGE_WORKFLOW](docs/CHANGE_WORKFLOW.md) | Nothing beyond the code, its tests and references |"
      },
      {
        "module": "release",
        "row": "| The verification status of a requirement | [VERIFICATION_MATRIX](docs/VERIFICATION_MATRIX.md) | VERIFICATION_MATRIX rows for affected requirements |"
      },
      {
        "module": "core",
        "row": "| Project identity, stack, tier, supported environments, commands | [PROJECT_PROFILE](PROJECT_PROFILE.md) | PROJECT_PROFILE; [README](README.md) if setup steps changed |"
      },
      {
        "module": "design",
        "row": "| Domain terms, invariants, lifecycles, transactions | [DOMAIN_RULES](docs/DOMAIN_RULES.md) | DOMAIN_RULES |"
      },
      {
        "module": "core",
        "row": "| What users run or see: commands, options, output formats (not functions inside the code) | [README](README.md) | README usage, in the same change |"
      },
      {
        "module": "design",
        "row": "| Boundaries between components or with external callers (APIs, published library API, file formats), schema, persistence, delivery scope | [DESIGN_DOC](DESIGN_DOC.md), [ARCHITECTURE](docs/ARCHITECTURE.md) | DESIGN_DOC; command-line usage stays in README |"
      },
      {
        "module": "data",
        "row": "| Import, export, file formats | [DATA_PORTABILITY](docs/DATA_PORTABILITY.md) | DATA_PORTABILITY |"
      },
      {
        "module": "ui",
        "row": "| UI, components, accessibility | [UX_DESIGN_SPEC](docs/UX_DESIGN_SPEC.md), [UI_PATTERNS](docs/UI_PATTERNS.md), [UX_ACCEPTANCE_CHECKLIST](docs/UX_ACCEPTANCE_CHECKLIST.md) | UI_PATTERNS for new or changed patterns; UX_DESIGN_SPEC for changed contracts |"
      },
      {
        "module": "ui",
        "row": "| Brand assets, tokens, themes | [BRANDING](docs/BRANDING.md) | BRANDING |"
      },
      {
        "module": "operations",
        "row": "| Authentication, authorization, secrets, dependencies, deployment, jobs, backups, automation | [SECURITY_PRODUCTION_SPEC](docs/SECURITY_PRODUCTION_SPEC.md), [RUNBOOKS](docs/RUNBOOKS.md) | Whichever of those owns the changed policy or procedure |"
      },
      {
        "module": "release",
        "row": "| A release candidate | [release readiness](docs/procedures/release-readiness.md), [PRODUCTION_READINESS](docs/PRODUCTION_READINESS.md) | PRODUCTION_READINESS |"
      },
      {
        "module": "enterprise",
        "row": "| Any change | [ENTERPRISE](docs/ENTERPRISE.md#traceability) | Ticket ID in each commit and the PR |"
      },
      {
        "module": "enterprise",
        "row": "| Approving, merging or accepting work | [ENTERPRISE](docs/ENTERPRISE.md#roles-and-separation-of-duties) | Nothing; the named role decides |"
      },
      {
        "module": "design",
        "row": "| Durable architecture or dependency decision | [ARCHITECTURE](docs/ARCHITECTURE.md) | New ADR from [the template](docs/decisions/ADR_TEMPLATE.md) |"
      },
      {
        "module": "release",
        "row": "| Time-sensitive platform or vendor claims | [SOURCES](docs/SOURCES.md) | SOURCES |"
      },
      {
        "module": "design",
        "row": "| Future scope | [ROADMAP](docs/ROADMAP.md) | ROADMAP (planning only; it authorizes nothing) |"
      },
      {
        "module": "operations",
        "row": "| A release or review deployment | [CHANGE_WORKFLOW](docs/CHANGE_WORKFLOW.md#deployment-and-review-cadence), [RUNBOOKS](docs/RUNBOOKS.md) | [RELEASE_NOTES](docs/RELEASE_NOTES.md): one short entry |"
      },
      {
        "module": "core",
        "row": "| Anything unresolved: decisions, gaps, defects, blockers | [OPEN_WORK](docs/OPEN_WORK.md) | OPEN_WORK |"
      },
      {
        "module": "core",
        "row": "| Documentation process and status vocabulary | [DOCUMENTATION](docs/DOCUMENTATION.md) | DOCUMENTATION |"
      }
    ],
    "routing_notes": [
      {
        "module": "stack-go",
        "row": "Go web stack: [profile](profiles/SERVER_RENDERED_WEB_GO.md)."
      },
      {
        "module": "stack-rust",
        "row": "Rust web stack: [profile](profiles/SERVER_RENDERED_WEB_RUST.md)."
      },
      {
        "module": "production-ops",
        "row": "Production operations: [profile](profiles/PRODUCTION_OPERATIONS.md)."
      }
    ],
    "procedures": [
      {
        "module": "core",
        "row": "| [bootstrap-project](docs/procedures/bootstrap-project.md) | Starting a project or filling an incomplete PROJECT_PROFILE |"
      },
      {
        "module": "core",
        "row": "| [final-audit](docs/procedures/final-audit.md) | Finishing any change, before reporting completion |"
      },
      {
        "module": "release",
        "row": "| [release-readiness](docs/procedures/release-readiness.md) | Preparing or evaluating a release candidate |"
      },
      {
        "module": "core",
        "row": "| [upgrade-guidance](docs/procedures/upgrade-guidance.md) | Adopting this guidance in an existing project, or updating an earlier adoption |"
      }
    ]
  },
  "profile_rows": [
    {
      "module": "enterprise",
      "row": "| Dependency audit | {{DEPENDENCY_AUDIT_COMMAND}} | Release | {{TEST_ENVIRONMENT}} | Not verified |"
    },
    {
      "module": "enterprise",
      "row": "| Software bill of materials (SBOM) | {{SBOM_COMMAND}} | Release | {{BUILD_ENVIRONMENT}} | Not verified |"
    },
    {
      "module": "enterprise",
      "row": "| License check | {{LICENSE_CHECK_COMMAND}} | Release | {{TEST_ENVIRONMENT}} | Not verified |"
    }
  ],
