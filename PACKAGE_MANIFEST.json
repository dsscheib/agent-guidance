{
  "package": "reusable-project-guidance",
  "version": "4.0-dev",
  "status": "unconfigured-templates",
  "procedures": "docs/procedures",
  "adapters": [
    {
      "dir": ".agents/skills",
      "tools": "Codex, Antigravity and Copilot CLI"
    },
    {
      "dir": ".claude/skills",
      "tools": "Claude Code and Copilot CLI"
    }
  ],
  "maintainer_roles": "maintainer/roles",
  "agent_dirs": [
    {
      "tool": "claude",
      "dir": ".claude/agents",
      "suffix": ".md"
    },
    {
      "tool": "codex",
      "dir": ".codex/agents",
      "suffix": ".toml"
    },
    {
      "tool": "copilot",
      "dir": ".github/agents",
      "suffix": ".agent.md"
    },
    {
      "tool": "antigravity",
      "dir": ".agents/agents",
      "suffix": ".md"
    }
  ],
  "repo_only": [
    "MAINTAINING.md",
    "LICENSE",
    "README.md",
    "docs/AGENT_TOOLS.md",
    "docs/procedures/upgrade-guidance.md",
    ".github/hooks/guidance_stop.py",
    "manage.py",
    "PACKAGE_MANIFEST.json",
    "maintainer/",
    ".claude/settings.local.json"
  ],
  "shim_exempt": [
    "maintainer/fixtures/"
  ],
  "modules": {
    "core": "Every project: AGENTS.md, PROJECT_PROFILE.md, OPEN_WORK.md, scripts/verify.py, pre-commit hook and CLI guardrails",
    "design": "Architecture, public boundaries, domain rules, invariants and ADRs",
    "operations": "Operator runbooks and release notes",
    "release-review": "Deep read-only pre-release audit procedure and selective skill",
    "release": "Verification matrix, release readiness record and release-readiness skill",
    "enterprise": "Traceability, separation of duties, CI evidence, PR template and supply-chain gates",
    "ui": "Feature: UI visual direction, tokens, matrix and non-negotiable floor",
    "ui-design": "Feature: on-demand ui-design specialist craft skill (includes docs/UI.md)",
    "stack-go": "Feature: server-rendered web profile for Go",
    "stack-rust": "Feature: server-rendered web profile for Rust",
    "embedded": "Feature: embedded firmware and hardware profile"
  },
  "tiers": {
    "prototype": [
      "core"
    ],
    "internal": [
      "core",
      "design",
      "operations"
    ],
    "production": [
      "core",
      "design",
      "operations",
      "release-review",
      "release"
    ],
    "enterprise": [
      "core",
      "design",
      "operations",
      "release-review",
      "release",
      "enterprise"
    ]
  },
  "features": {
    "release-review": [
      "release-review"
    ],
    "ui": [
      "ui"
    ],
    "ui-design": [
      "ui",
      "ui-design"
    ],
    "stack-go": [
      "stack-go"
    ],
    "stack-rust": [
      "stack-rust"
    ],
    "embedded": [
      "embedded"
    ]
  },
  "tools": {
    "claude": {
      "name": "Claude Code",
      "paths": [
        "CLAUDE.md",
        ".claude/"
      ]
    },
    "codex": {
      "name": "Codex",
      "paths": [
        ".codex/",
        ".agents/"
      ]
    },
    "antigravity": {
      "name": "Antigravity",
      "paths": [
        ".agents/",
        ".agents/agents/"
      ]
    },
    "copilot": {
      "name": "Copilot CLI",
      "paths": [
        ".github/hooks/",
        ".agents/",
        ".github/agents/"
      ]
    }
  },
  "agents_tables": {
    "routing": [
      {
        "module": "core",
        "row": "| Any behavior | [PROJECT_PROFILE](PROJECT_PROFILE.md) (Command inventory) | Tests for changed behavior; run `python3 scripts/verify.py --verify` |"
      },
      {
        "module": "core",
        "row": "| What users run or see (CLI options, usage, output formats) | [README](README.md) | README usage in the same change (never UAT steps) |"
      },
      {
        "module": "design",
        "row": "| Architecture, public boundaries (service/library APIs, schemas, file formats), domain terms, invariants, lifecycles | [DESIGN_DOC](DESIGN_DOC.md) | DESIGN_DOC (internal helpers and CLI options/output formats stay out) |"
      },
      {
        "module": "design",
        "row": "| Durable architecture or dependency decision | [DESIGN_DOC](DESIGN_DOC.md) | New ADR from [the template](docs/decisions/ADR_TEMPLATE.md) |"
      },
      {
        "module": "operations",
        "row": "| Deployment, backups, jobs, recovery, secrets, or automation | [docs/RUNBOOKS](docs/RUNBOOKS.md) | docs/RUNBOOKS |"
      },
      {
        "module": "operations",
        "row": "| A release or review deployment | [docs/RUNBOOKS](docs/RUNBOOKS.md) | One short entry in [docs/RELEASE_NOTES](docs/RELEASE_NOTES.md) |"
      },
      {
        "module": "release",
        "row": "| Requirement verification status | [docs/VERIFICATION_MATRIX](docs/VERIFICATION_MATRIX.md) | Affected rows in docs/VERIFICATION_MATRIX |"
      },
      {
        "module": "release",
        "row": "| A release candidate | [release-readiness](docs/procedures/release-readiness.md), [docs/PRODUCTION_READINESS](docs/PRODUCTION_READINESS.md) | docs/PRODUCTION_READINESS |"
      },
      {
        "module": "ui",
        "row": "| UI, visual direction, components, or accessibility | [docs/UI](docs/UI.md) | docs/UI for new tokens or patterns |"
      },
      {
        "module": "enterprise",
        "row": "| Ticket traceability or approving/merging/accepting work | [docs/ENTERPRISE](docs/ENTERPRISE.md) | Ticket ID in commits and PR; named role decides |"
      },
      {
        "module": "core",
        "row": "| Anything unresolved (decisions, gaps, defects, blockers) | [docs/OPEN_WORK](docs/OPEN_WORK.md) | Update docs/OPEN_WORK in place |"
      }
    ],
    "routing_notes": [
      {
        "module": "stack-go",
        "row": "Go web stack: [profile](profiles/SERVER_RENDERED_WEB_GO.md)."
      },
      {
        "module": "stack-rust",
        "row": "Rust web stack: [profile](profiles/SERVER_RENDERED_WEB_RUST.md)."
      },
      {
        "module": "embedded",
        "row": "Embedded firmware and hardware: [profile](profiles/EMBEDDED_FIRMWARE.md)."
      }
    ],
    "procedures": [
      {
        "module": "release-review",
        "row": "| [release-review](docs/procedures/release-review.md) | Deep read-only pre-release audit across every risk area |"
      },
      {
        "module": "release",
        "row": "| [release-readiness](docs/procedures/release-readiness.md) | Assembling gate evidence and evaluating a release candidate |"
      },
      {
        "module": "ui-design",
        "row": "| [ui-design](docs/procedures/ui-design.md) | Designing a new UI, setting visual direction, or polishing screens and interaction craft |"
      }
    ]
  },
  "profile_rows": [
    {
      "module": "enterprise",
      "row": "| Dependency audit | {{DEPENDENCY_AUDIT_COMMAND}} | Release | {{TEST_ENVIRONMENT}} | Not verified |"
    },
    {
      "module": "enterprise",
      "row": "| Software bill of materials (SBOM) | {{SBOM_COMMAND}} | Release | {{BUILD_ENVIRONMENT}} | Not verified |"
    },
    {
      "module": "enterprise",
      "row": "| License check | {{LICENSE_CHECK_COMMAND}} | Release | {{TEST_ENVIRONMENT}} | Not verified |"
    }
  ],
  "guardrail_rules": [
    {
      "module": "enterprise",
      "action": "merge a pull request",
      "claude": "Bash(gh pr merge:*)",
      "codex": [
        "gh",
        "pr",
        "merge"
      ],
      "copilot": [
        "pr",
        "merge"
      ]
    },
    {
      "module": "enterprise",
      "action": "publish a release",
      "claude": "Bash(gh release create:*)",
      "codex": [
        "gh",
        "release",
        "create"
      ],
      "copilot": [
        "release",
        "create"
      ]
    }
  ],
